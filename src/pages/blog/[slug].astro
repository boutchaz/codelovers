---
import { render } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import { SITE_URL } from "@/data/constants";
import { getListedPosts, getPosts } from "@/data/blog";

export async function getStaticPaths() {
  // Unlisted posts still get a page; drafts do not.
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const french = post.data.language === "fr";
const { Content } = await render(post);

// Drafts and unlisted posts are never suggested. Posts about the same product come first.
const related = (await getListedPosts())
  .filter((item) => item.id !== post.id && item.data.language === post.data.language)
  .sort(
    (a, b) =>
      Number(b.data.product === post.data.product) - Number(a.data.product === post.data.product) ||
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .slice(0, 2);

const BOOKING_URL = "https://cal.com/codelovers/30min?user=codelovers&overlayCalendar=true&layout=month_view";
const productCtas = {
  "passion-fitness": {
    fr: {
      title: "Voir Passion Fitness dans votre salle",
      body: "Réservations, présence et progression des ceintures dans une seule application, pour vos coachs et vos membres. Réservez 30 minutes pour une démo.",
      book: "Réserver une démo",
      more: "Lire le cas client",
    },
    en: {
      title: "See Passion Fitness in your gym",
      body: "Bookings, attendance and belt progression in one app for your coaches and members. Book 30 minutes for a demo.",
      book: "Book a demo",
      more: "Read the case study",
    },
  },
} as const;
const productCta = post.data.product
  ? productCtas[post.data.product as keyof typeof productCtas]?.[post.data.language]
  : undefined;

function formatPostDate(date: Date): string {
  return date.toLocaleDateString(french ? "fr-FR" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  inLanguage: post.data.language,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.author,
    url: `${SITE_URL}/`,
  },
  publisher: {
    "@type": "Organization",
    name: "CodeLovers",
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/logo.png`,
  },
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
};
---

<SiteShell
  lang={post.data.language}
  title={post.data.title}
  description={post.data.description}
  canonical={`/blog/${post.id}/`}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, "\\u003c")} slot="head" />

  {post.data.erpRevision && <meta slot="head" name="codelovers-content-revision" content={post.data.erpRevision} />}

  <article class="pb-24 pt-32 sm:pt-40" data-article={post.id} data-product={post.data.product || undefined}>
    <div class="mx-auto max-w-[760px] px-6 lg:px-8">
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-white"
      >
        <span aria-hidden="true">←</span> {french ? "Tous les articles" : "All posts"}
      </a>

      <header class="mt-8 space-y-5 border-b border-white/10 pb-10">
        <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.25em] text-rose-200">
          <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
          <span class="text-white/20">·</span>
          <span>{post.data.author}</span>
        </div>
        <h1 class="text-4xl font-bold leading-tight text-white sm:text-5xl">{post.data.title}</h1>
        <p class="text-lg leading-relaxed text-slate-300">{post.data.description}</p>
        {
          post.data.tags.length > 0 ? (
            <div class="flex flex-wrap gap-2 pt-2">
              {post.data.tags.map((tag: string) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-rose-200">
                  {tag}
                </span>
              ))}
            </div>
          ) : null
        }
      </header>

      <div class="blog-prose mt-10 space-y-5 text-base leading-relaxed text-slate-300 sm:text-lg">
        <Content />
      </div>

      <div
        class="mt-14 rounded-[28px] border border-white/10 bg-gradient-to-r from-rose-600/25 via-red-500/15 to-orange-400/20 p-8 sm:p-10"
      >
        {
          productCta ? (
            <>
              <h2 class="text-2xl font-semibold text-white">{productCta.title}</h2>
              <p class="mt-3 text-slate-200">{productCta.body}</p>
              <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a
                  href={BOOKING_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-rose-100"
                >
                  {productCta.book} <span aria-hidden="true">→</span>
                </a>
                <a
                  href={`/case-studies/${post.data.product}/`}
                  class="text-sm text-slate-200 underline decoration-white/30 underline-offset-4 hover:text-white"
                >
                  {productCta.more}
                </a>
              </div>
            </>
          ) : (
            <>
              <h2 class="text-2xl font-semibold text-white">{french ? "Construisez avec CodeLovers" : "Build with CodeLovers"}</h2>
              <p class="mt-3 text-slate-200">
                {french ? "Un projet en tête ? Réunissons stratégie, design et ingénierie pour le concrétiser." : "Have a product challenge? We will assemble strategy, design, and engineering around your outcomes."}
              </p>
              <a
                href="/#contact"
                class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-rose-100"
              >
                {french ? "Parlons de votre projet" : "Start a project"} <span aria-hidden="true">→</span>
              </a>
            </>
          )
        }
      </div>

      {
        related.length > 0 ? (
          <aside class="mt-16 border-t border-white/10 pt-12">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-rose-200">
              {french ? "À lire aussi" : "More from the studio"}
            </p>
            <ul class="mt-6 space-y-4">
              {related.map((item) => (
                <li>
                  <a
                    href={`/blog/${item.id}/`}
                    class="text-lg font-medium text-white transition hover:text-rose-200"
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        ) : null
      }
    </div>
  </article>
</SiteShell>
