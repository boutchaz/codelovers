---
import { render } from "astro:content";
import BlogArticle from "@/components/blog/BlogArticle.astro";
import { getPosts } from "@/data/blog";

export async function getStaticPaths() {
  // Unlisted posts still get a page; drafts do not.
  return (await getPosts()).map((post) => ({params: {slug: post.id}, props: {post}}));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogArticle post={post} headings={headings}><Content /></BlogArticle>
