---
import { getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import SectionBadge from "@/components/ui/SectionBadge.astro";

// Unlisted posts keep their URL but are not offered on the index.
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.unlisted)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatPostDate(date: Date, language: string): string {
  return date.toLocaleDateString(language === "fr" ? "fr-FR" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<SiteShell
  lang="fr"
  title="Blog"
  description="Guides pratiques pour les gérants de salles de sport et d’arts martiaux au Maroc : réservations, suivi des membres, progression et données."
  canonical="/blog/"
>
  <section class="pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-[900px] px-6 lg:px-8">
      <SectionBadge>Blog</SectionBadge>
      <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl">
        Guides pour les
        <span
          class="bg-gradient-to-r from-rose-400 via-red-400 to-orange-300 bg-clip-text text-transparent"
          >gérants de salle</span
        >
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        Réservations, présence, progression des élèves et données des membres : des conseils
        concrets pour faire tourner une salle de sport ou d’arts martiaux, sans jargon.
      </p>
    </div>
  </section>

  <section class="border-t border-white/5 pb-28">
    <div class="mx-auto max-w-[900px] space-y-6 px-6 pt-12 lg:px-8">
      {
        posts.length === 0 ? (
          <p class="text-slate-400">Articles bientôt disponibles.</p>
        ) : (
          posts.map((post) => (
            <article class="rounded-[28px] border border-white/10 bg-white/[0.03] p-8 transition hover:border-rose-500/30 hover:bg-white/[0.05] sm:p-10">
              <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.25em] text-rose-200">
                <time datetime={post.data.date.toISOString()}>
                  {formatPostDate(post.data.date, post.data.language)}
                </time>
                <span lang={post.data.language}>{post.data.language === "fr" ? "Français" : "English"}</span>
                {post.data.tags[0] ? (
                  <>
                    <span class="text-white/20">·</span>
                    <span>{post.data.tags[0]}</span>
                  </>
                ) : null}
              </div>
              <h2 class="mt-4 text-2xl font-semibold text-white sm:text-3xl">
                <a href={`/blog/${post.id}/`} class="transition hover:text-rose-200">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-base leading-relaxed text-slate-300">{post.data.description}</p>
              <a
                href={`/blog/${post.id}/`}
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rose-300 transition hover:text-rose-200"
              >
                {post.data.language === "fr" ? "Lire l’article" : "Read article"} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        )
      }
    </div>
  </section>
</SiteShell>
