---
import SiteShell from "@/layouts/SiteShell.astro";
---

<!--
  nginx serves this page for every missing URL (error_page 404 /404.html). It needs the shared layout: without it
  the page has no <html>, no styles and no header or footer to get back to the site.
-->
<SiteShell title="Page not found" description="The page you are looking for does not exist or has been moved.">
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-6 pb-20 pt-40 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-rose-400">404</p>
    <h1 class="mt-4 text-4xl font-bold text-white sm:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-md text-base text-slate-400">
      The page you&apos;re looking for doesn&apos;t exist or has been moved.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-rose-600 via-red-500 to-orange-400 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-rose-500/30"
      >
        Back to home
        <span aria-hidden="true">→</span>
      </a>
      <a href="/blog/" class="text-sm text-slate-300 underline decoration-white/30 underline-offset-4 hover:text-white">Blog</a>
      <a href="/fr/" lang="fr" class="text-sm text-slate-300 underline decoration-white/30 underline-offset-4 hover:text-white">Page introuvable ? Accueil en français</a>
    </div>
  </section>
</SiteShell>
