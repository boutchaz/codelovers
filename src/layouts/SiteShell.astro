---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReviewHeader from "@/components/ReviewHeader.astro";
import PreviewAppearance from "@/components/PreviewAppearance.astro";

interface Props {
  preview?: boolean;
  title: string;
  description: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  lang?: "en" | "fr";
}

const {
  preview = false,
  title,
  description,
  canonical,
  ogType,
  ogImage,
  publishedTime,
  lang,
} = Astro.props;
---

<BaseLayout preview={preview} title={title} description={description} canonical={canonical} ogType={ogType} ogImage={ogImage} publishedTime={publishedTime} lang={lang}>
  <slot name="head" slot="head" />
  <div class="site-shell min-h-screen overflow-x-clip bg-slate-950 text-slate-100">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-rose-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      {lang === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    {preview ? <ReviewHeader lang={lang}/> : <Header lang={lang} />}
    {preview && <PreviewAppearance/>}
    <main id="main-content" class="relative">
      <slot />
    </main>
    <Footer lang={lang} preview={preview}/>

    <script>
      import "@/scripts/reveal";
      import "@/scripts/clean-anchors";
    </script>
  </div>
</BaseLayout>
