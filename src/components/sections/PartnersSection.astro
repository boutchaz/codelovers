---
import { heroMetrics, partners } from "@/data/constants";
---

<section class="reveal-on-scroll border-y border-white/5 bg-slate-950/60 py-12 sm:py-14">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-10 px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {
        heroMetrics.map((metric) => (
          <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
            <p class="bg-gradient-to-br from-white via-rose-100 to-rose-200 bg-clip-text text-2xl font-semibold text-transparent sm:text-3xl">
              {metric.value}
            </p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-slate-400">{metric.label}</p>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-wrap items-center justify-center gap-8 text-sm uppercase tracking-[0.3em] text-slate-400"
    >
      <span class="text-xs font-semibold text-rose-200">
        Trusted by teams that lead their markets
      </span>
      <div class="hidden h-3 w-px bg-white/10 sm:block"></div>
      {
        partners.map((partner) => (
          <span class="text-xs font-medium text-slate-300">{partner}</span>
        ))
      }
    </div>
  </div>
</section>
