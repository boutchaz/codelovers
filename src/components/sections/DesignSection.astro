---
// CSS sticky holds the panel; GSAP ScrollTrigger only scrubs the reveal.
// Avoids GSAP pin/transform ghosts under the fixed header.
---

<section data-design-section class="relative h-[200vh] bg-slate-950">
  <div class="sticky top-0 flex h-screen items-center justify-center overflow-hidden pt-16 sm:pt-20">
    <div
      class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center justify-center px-6 py-10 text-center"
    >
      <h2 class="mb-6 flex flex-wrap justify-center gap-1 sm:mb-8 sm:gap-2" aria-label="Design">
        {
          ["D", "E", "S", "I", "G", "N"].map((letter) => (
            <span
              data-design-letter
              class="inline-block bg-gradient-to-r from-rose-400 via-red-400 to-orange-300 bg-clip-text text-[clamp(2.75rem,9vw,7rem)] font-bold leading-none text-transparent"
              style="opacity: 0"
              aria-hidden="true"
            >
              {letter}
            </span>
          ))
        }
      </h2>

      <div data-design-content class="max-w-2xl space-y-6" style="opacity: 0">
        <p class="text-base leading-relaxed text-slate-300 sm:text-lg">
          We craft digital experiences that blend creativity, technology, and human-centered design
          to create meaningful connections between brands and their audiences.
        </p>

        <a
          href="/#contact"
          class="inline-flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-gradient-to-r from-rose-600 via-red-500 to-orange-400 px-9 text-base font-semibold leading-none text-white shadow-lg shadow-rose-500/30 transition-all hover:-translate-y-0.5 hover:scale-[1.02] hover:shadow-rose-500/50 sm:h-14 sm:px-12"
          style="padding: 0.75rem 2rem"
        >
          Get in Touch
        </a>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute left-1/4 top-1/4 h-96 w-96 rounded-full bg-rose-500/20 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl"></div>
    </div>
  </div>
</section>

<script>
  import "@/scripts/design";
</script>
