---
import SectionBadge from "@/components/ui/SectionBadge.astro";
import { caseStudies } from "@/data/constants";
import { caseStudiesFr } from "@/data/constants-fr";

const studies = caseStudies.slice(0, 3).map((study) => ({
  ...study,
  ...caseStudiesFr[study.title],
}));

const slugMap: Record<string, string> = {
  Snookly: "snookly",
  "Passion Fitness": "passion-fitness",
  AgroGina: "agrogina",
  "LoginTel SaaS": "logintel-saas",
  "WhatsApp Reservation Bot": "whatsapp-reservation-bot",
};
---

<section id="works" class="reveal-on-scroll py-28">
  <div class="mx-auto w-full max-w-[1280px] px-6 lg:px-8">
    <div class="mb-16 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="space-y-4">
        <SectionBadge>Études de cas</SectionBadge>
        <h2 class="text-4xl font-bold text-white sm:text-5xl">
          Des produits à voir. Des usages concrets.
        </h2>
        <p class="max-w-3xl text-lg text-slate-300">
          Découvrez comment nous relions les usages des exploitations agricoles, clubs d’arts martiaux et salles de snooker dans des produits web et mobile.
        </p>
      </div>

      <a
        href="#contact"
        class="self-start rounded-full border border-white/15 px-6 py-3 sm:px-8 sm:py-3.5 text-sm font-semibold text-white transition hover:border-rose-400/40 hover:text-rose-200"
      >
        Partagez votre défi →
      </a>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {
        studies.map((study) => {
          const slug = slugMap[study.title];
          const internalUrl = slug ? `/fr/case-studies/${slug}/` : null;
          const hasExternalLink = "href" in study && study.href;

          const className =
            "group relative overflow-hidden rounded-[36px] border border-white/10 bg-white/[0.04] p-6 transition-all hover:-translate-y-2 hover:border-rose-500/40 hover:bg-white/[0.06] sm:p-7 lg:p-7";

          const content = (
            <>
              <div class={`case-study-glow ${study.gradient}`} />
              <div class="relative flex h-full flex-col justify-between space-y-6">
                <div class="space-y-3">
                  <img src={`/images/case-studies/${slug}.webp`} alt={`Aperçu du site public de ${study.title}`} width="1280" height="720" loading="lazy" class="mb-6 aspect-video w-full rounded-2xl border border-white/10 object-cover" />
                  <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.3em] text-rose-200 sm:px-4">
                    {study.category}
                  </span>
                  <h3 class="text-2xl font-semibold text-white">
                    {study.title}
                    {internalUrl && (
                      <span class="ml-2 text-base font-medium text-rose-300 transition group-hover:text-rose-200">
                        →
                      </span>
                    )}
                  </h3>
                  <p class="text-sm text-slate-300">{study.summary}</p>
                </div>
                <div class="flex items-end justify-between gap-4">
                  <div>
                    <p class="text-4xl font-semibold text-white">{study.result}</p>
                    <p class="mt-2 text-xs uppercase tracking-[0.3em] text-rose-200">{study.metric}</p>
                  </div>
                  {hasExternalLink && (
                    <a
                      href={(study as any).href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="relative z-10 text-xs text-rose-300 transition hover:text-rose-200"
                    >
                      Site en ligne ↗
                    </a>
                  )}
                </div>
              </div>
            </>
          );

          return (
            <div class={className}>
              {content}
              {internalUrl && (
                <a
                  href={internalUrl}
                  class="absolute inset-0 z-0"
                  aria-label={`Voir l'étude de cas ${study.title}`}
                >
                  <span class="sr-only">Voir l'étude de cas {study.title}</span>
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
