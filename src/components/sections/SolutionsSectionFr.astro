---
import SectionBadge from "@/components/ui/SectionBadge.astro";
import { capabilitiesFr } from "@/data/constants-fr";
---

<section id="solutions" class="reveal-on-scroll relative py-28">
  <div class="mx-auto w-full max-w-[1280px] px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <SectionBadge>Nos capacités</SectionBadge>
      <h2 class="mt-6 text-4xl font-bold text-white sm:text-5xl">
        De l'idée à l'échelle
      </h2>
      <p class="mt-6 text-lg text-slate-300">
        Une approche de bout en bout pour transformer les défis produit en plateformes logicielles durables.
      </p>
    </div>

    <div class="mt-20 grid gap-8 lg:grid-cols-3">
      {
        capabilitiesFr.map((capability) => (
          <div class="group relative overflow-hidden rounded-[36px] border border-white/10 bg-white/[0.04] p-10 transition-all hover:-translate-y-2 hover:border-rose-500/40 hover:bg-white/[0.06] sm:p-12">
            <div class="absolute inset-0 bg-gradient-to-br from-rose-500/10 via-red-500/5 to-orange-400/10 opacity-0 transition-opacity group-hover:opacity-100" />
            <div class="relative space-y-6">
              <h3 class="text-2xl font-semibold text-white">{capability.title}</h3>
              <p class="text-sm leading-relaxed text-slate-300">{capability.description}</p>
              <ul class="space-y-3 text-sm text-slate-400">
                {capability.points.map((point) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-0.5 h-5 w-5 flex-shrink-0 text-rose-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
