---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const classes = [
  "inline-flex items-center rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em]",
  "border-white/10 bg-white/5 text-rose-200",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  <slot />
</div>
