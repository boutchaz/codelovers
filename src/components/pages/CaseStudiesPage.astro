---
// The case studies list in either language. /case-studies/ and /fr/case-studies/ both render this component.
import ProjectCTA from "@/components/ProjectCTA.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import SectionBadge from "@/components/ui/SectionBadge.astro";
import { SITE_URL, caseStudies } from "@/data/constants";
import { caseStudiesFr } from "@/data/constants-fr";
import type { Lang } from "@/data/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fr = lang === "fr";
const prefix = fr ? "/fr" : "";

type Study = {
  title: string;
  category: string;
  summary: string;
  result: string;
  metric: string;
  gradient: string;
  href?: string;
};

// French fields replace the English ones where they exist (see caseStudiesFr).
const studies: Study[] = caseStudies.map((study) => (fr ? { ...study, ...caseStudiesFr[study.title] } : study));

const slugMap: Record<string, string> = {
  Snookly: "snookly",
  "Passion Fitness": "passion-fitness",
  AgroGina: "agrogina",
  "LoginTel SaaS": "logintel-saas",
  "WhatsApp Reservation Bot": "whatsapp-reservation-bot",
};

const text = {
  en: {
    title: "Case Studies",
    description:
      "Real-world transformations: IoT cold chain monitoring, AgroGina satellite analytics, SaaS automation, Shopify Hydrogen e-commerce, and enterprise ERP solutions by CodeLovers.",
    badge: "Case studies",
    heading: "Production systems that",
    headingAccent: "solve real problems",
    intro:
      "Multi-tenant SaaS platforms, IoT monitoring systems, and agricultural tech in production. From snooker club operations to satellite crop analytics.",
    live: "Live site",
    crumbHome: "Home",
    crumbPage: "Case Studies",
  },
  fr: {
    title: "Études de cas",
    description:
      "Des transformations concrètes : surveillance IoT de la chaîne du froid, analyse satellite AgroGina, automatisation SaaS, e-commerce Shopify Hydrogen et solutions ERP d'entreprise par CodeLovers.",
    badge: "Études de cas",
    heading: "Des systèmes en production qui",
    headingAccent: "résolvent de vrais problèmes",
    intro:
      "Plateformes SaaS multi-locataires, systèmes de surveillance IoT et agritech en production. Des opérations de clubs de snooker à l'analyse satellite des cultures.",
    live: "Site en ligne",
    crumbHome: "Accueil",
    crumbPage: "Études de cas",
  },
}[lang];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: text.crumbHome, item: `${SITE_URL}${prefix}/` },
    { "@type": "ListItem", position: 2, name: text.crumbPage, item: `${SITE_URL}${prefix}/case-studies/` },
  ],
};
---

<SiteShell
  lang={lang}
  title={text.title}
  description={text.description}
  canonical={`${prefix}/case-studies/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

  <section class="pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-8">
      <SectionBadge>{text.badge}</SectionBadge>
      <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
        {text.heading}{" "}
        <span
          class="bg-gradient-to-r from-rose-400 via-red-400 to-orange-300 bg-clip-text text-transparent"
          >{text.headingAccent}</span
        >
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">{text.intro}</p>
    </div>
  </section>

  <section class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        {
          studies.map((study) => {
            const slug = slugMap[study.title];
            const internalUrl = slug ? `${prefix}/case-studies/${slug}/` : null;
            const hasExternalLink = Boolean(study.href);

            const className =
              "group relative overflow-hidden rounded-[36px] border border-white/10 bg-white/[0.04] p-10 transition-all hover:-translate-y-2 hover:border-rose-500/40 hover:bg-white/[0.06] sm:p-12 lg:p-14";

            const content = (
              <>
                <div
                  class={`absolute inset-0 bg-gradient-to-br ${study.gradient} opacity-0 transition-opacity group-hover:opacity-30`}
                />
                <div class="relative flex h-full flex-col justify-between space-y-6">
                  <div class="space-y-4">
                    <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.3em] text-rose-200">
                      {study.category}
                    </span>
                    <h2 class="text-2xl font-semibold text-white">
                      {study.title}
                      {internalUrl && (
                        <span class="ml-2 text-base font-medium text-rose-300 transition group-hover:text-rose-200">
                          →
                        </span>
                      )}
                    </h2>
                    <p class="text-sm leading-relaxed text-slate-300">{study.summary}</p>
                  </div>
                  <div class="flex items-end justify-between gap-4 border-t border-white/10 pt-6">
                    <div>
                      <p class="text-4xl font-semibold text-white">{study.result}</p>
                      <p class="mt-2 text-xs uppercase tracking-[0.3em] text-rose-200">
                        {study.metric}
                      </p>
                    </div>
                    {hasExternalLink && (
                      <a
                        href={study.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-rose-300 transition hover:text-rose-200"
                        onclick="event.stopPropagation()"
                      >
                        {text.live} ↗
                      </a>
                    )}
                  </div>
                </div>
              </>
            );

            return internalUrl ? (
              <a href={internalUrl} class={`${className} block`}>
                {content}
              </a>
            ) : (
              <div class={className}>{content}</div>
            );
          })
        }
      </div>
    </div>
  </section>

  <ProjectCTA lang={lang} />
</SiteShell>
