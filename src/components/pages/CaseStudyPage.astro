---
// One case study in either language. /case-studies/<slug>/ and /fr/case-studies/<slug>/ both render this component;
// the English and French versions come from the "case-studies" and "case-studies-fr" collections.
import { render, type CollectionEntry } from "astro:content";
import ProjectCTA from "@/components/ProjectCTA.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import SectionBadge from "@/components/ui/SectionBadge.astro";
import { SITE_URL } from "@/data/constants";
import type { Lang } from "@/data/i18n";

interface Props {
  study: CollectionEntry<"case-studies"> | CollectionEntry<"case-studies-fr">;
  lang: Lang;
}

const { study, lang } = Astro.props;
const fr = lang === "fr";
const prefix = fr ? "/fr" : "";
const { Content } = await render(study);
const { title, category, description, gradient, externalUrl, date, headline, preview, workflow } = study.data;

const text = fr
  ? {
      titleSuffix: "Étude de cas",
      by: "Par CodeLovers",
      visit: "Voir le site en ligne",
      crumbHome: "Accueil",
      crumbList: "Études de cas",
      locale: "fr-FR",
    }
  : {
      titleSuffix: "Case Study",
      by: "By CodeLovers",
      visit: "Visit live site",
      crumbHome: "Home",
      crumbList: "Case Studies",
      locale: "en-US",
    };

const formattedDate = new Intl.DateTimeFormat(text.locale, {
  year: "numeric",
  month: "long",
}).format(date);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: text.crumbHome, item: `${SITE_URL}${prefix}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: text.crumbList,
      item: `${SITE_URL}${prefix}/case-studies/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: `${SITE_URL}${prefix}/case-studies/${study.id}/`,
    },
  ],
};

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  inLanguage: lang,
  headline: title,
  description: description,
  datePublished: date.toISOString(),
  author: {
    "@type": "Organization",
    name: "CodeLovers",
    url: SITE_URL,
  },
  publisher: {
    "@type": "Organization",
    name: "CodeLovers",
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/logo.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${SITE_URL}${prefix}/case-studies/${study.id}/`,
  },
};
---

<SiteShell
  lang={lang}
  title={`${title} ${text.titleSuffix}`}
  description={description}
  canonical={`${prefix}/case-studies/${study.id}/`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    slot="head"
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} slot="head"
  />

  <article class="pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <SectionBadge>{category}</SectionBadge>
      <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      {headline && <p class="mt-5 max-w-3xl text-2xl font-medium leading-tight text-white sm:text-3xl">{headline}</p>}
      <p class="mt-6 text-lg leading-relaxed text-slate-300">
        {description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-slate-400">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{text.by}</span>
        {
          externalUrl && (
            <>
              <span>•</span>
              <a
                href={externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-rose-400 transition hover:text-rose-300"
              >
                {text.visit} ↗
              </a>
            </>
          )
        }
      </div>

      {preview && (
        <figure class="mt-10 overflow-hidden rounded-3xl border border-white/15 bg-slate-900 shadow-2xl">
          <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-rose-400/70"></span><span class="h-2 w-2 rounded-full bg-orange-300/70"></span><span class="h-2 w-2 rounded-full bg-emerald-300/70"></span>
            <span class="ml-3 text-xs text-slate-400">{title}</span>
          </div>
          <img src={preview} alt={fr ? `Aperçu du site public de ${title}` : `${title} public website preview`} width="1280" height="720" class="block h-auto w-full" fetchpriority="high" />
          <figcaption class="px-5 py-3 text-xs text-slate-400">{fr ? "Aperçu du site public · novembre 2026. Les écrans de démonstration peuvent contenir des données d’exemple." : "Public website preview · November 2026. Demonstration screens may contain sample data."}</figcaption>
        </figure>
      )}
      {workflow.length > 0 && (
        <section class={`mt-10 overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br ${gradient} p-6 sm:p-8`} aria-label={fr ? "Le parcours produit" : "The product workflow"}>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-rose-200">{fr ? "Le parcours produit" : "The product workflow"}</p>
          <ol class="mt-6 grid gap-6 sm:grid-cols-3">
            {workflow.map((step, index) => (
              <li class="relative border-t border-white/20 pt-5">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10 font-mono text-sm text-rose-200">{String(index + 1).padStart(2, "0")}</span>
                <h2 class="mt-4 text-lg font-semibold text-white">{step.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">{step.description}</p>
                {index < workflow.length - 1 && <span aria-hidden="true" class="absolute right-0 top-6 hidden text-2xl text-rose-200/70 sm:block">→</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      <div class="prose prose-invert mt-12 max-w-none">
        <Content />
      </div>
    </div>
  </article>

  <ProjectCTA lang={lang} />
</SiteShell>

<style is:global>
  .prose h2 {
    margin-top: 3rem;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 600;
    color: white;
  }

  .prose h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: white;
  }

  .prose p {
    margin-top: 1rem;
    line-height: 1.75;
    color: rgb(203 213 225);
  }

  .prose ul,
  .prose ol {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: rgb(203 213 225);
  }

  .prose li {
    line-height: 1.75;
  }

  .prose strong {
    font-weight: 600;
    color: white;
  }

  .prose code {
    border-radius: 0.25rem;
    background-color: rgb(255 255 255 / 0.1);
    padding: 0.125rem 0.375rem;
    font-family: "Geist Mono", monospace;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgb(251 207 232);
  }

  .prose pre {
    margin-top: 1.5rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background-color: rgb(15 23 42 / 0.5);
    padding: 1rem;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: rgb(203 213 225);
  }

  .prose a {
    color: rgb(251 113 133);
    text-decoration-line: none;
    transition-property: color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }

  .prose a:hover {
    color: rgb(244 114 182);
  }

  .prose hr {
    margin-top: 3rem;
    margin-bottom: 3rem;
    border-color: rgb(255 255 255 / 0.1);
  }

  .prose blockquote {
    border-left-width: 4px;
    border-left-color: rgb(244 63 94 / 0.5);
    padding-left: 1rem;
    font-style: italic;
    color: rgb(148 163 184);
  }
</style>
