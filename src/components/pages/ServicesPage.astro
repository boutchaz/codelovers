---
// The services page in either language. /services/ and /fr/services/ both render this component.
import SiteShell from "@/layouts/SiteShell.astro";
import SectionBadge from "@/components/ui/SectionBadge.astro";
import { SITE_URL, services, capabilities } from "@/data/constants";
import { servicesFr, capabilitiesFr } from "@/data/constants-fr";
import type { Lang } from "@/data/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fr = lang === "fr";
const prefix = fr ? "/fr" : "";

// The French service list has the same order as the English one; the slug (the anchor) comes from the English entry.
const serviceList = services.map((service, i) => (fr ? { ...service, ...servicesFr[i] } : service));
const capabilityList = fr ? capabilitiesFr : capabilities;

const text = {
  en: {
    title: "Services",
    description:
      "Full-stack development, SaaS engineering, IoT systems, E-Commerce solutions, DevOps infrastructure, and enterprise software delivered by CodeLovers from Morocco.",
    badge: "Capabilities",
    heading: "End-to-end service lines that shape",
    headingAccent: "digital leaders",
    intro:
      "We assemble cross-functional squads across strategy, design, technology, and engineering — tailored to the mission at hand.",
    processBadge: "Our process",
    processTitle: "From idea to impact in three phases",
    steps: [
      {
        title: "Discover & Define",
        description:
          "We start with deep problem framing through user research, market validation, and technical feasibility analysis to ensure we build the right thing.",
        deliverables: ["User research insights", "Lean validation report", "Technical roadmap"],
      },
      {
        title: "Design & Build",
        description:
          "Interface and interaction design supported by robust engineering delivery. We prototype rapidly and iterate based on real feedback.",
        deliverables: ["Interactive prototypes", "Frontend & Backend development", "Cloud infrastructure"],
      },
      {
        title: "Launch & Scale",
        description:
          "Continuous iteration, data analytics, and product-led growth experiments. We stay engaged post-launch to optimize outcomes.",
        deliverables: ["CI/CD pipelines", "Analytics instrumentation", "Growth optimization"],
      },
    ],
    outcomesBadge: "Outcomes first",
    outcomesTitle: "Solutions that align brand, experience, and engineering",
    ctaTitle: "Have a project in mind?",
    ctaBody: "Tell us about your challenge and we'll assemble the right squad.",
    ctaBook: "Book a working session",
    ctaWork: "View our work",
    crumbHome: "Home",
    crumbPage: "Services",
  },
  fr: {
    title: "Services",
    description:
      "Développement full-stack, ingénierie SaaS, systèmes IoT, solutions E-Commerce, infrastructure DevOps et logiciels d'entreprise, livrés par CodeLovers depuis le Maroc.",
    badge: "Expertises",
    heading: "Des services de bout en bout qui façonnent les",
    headingAccent: "leaders du numérique",
    intro:
      "Nous réunissons des équipes pluridisciplinaires en stratégie, design, technologie et ingénierie — adaptées à la mission du moment.",
    processBadge: "Notre méthode",
    processTitle: "De l'idée à l'impact en trois phases",
    steps: [
      {
        title: "Découvrir & Définir",
        description:
          "Nous commençons par un cadrage approfondi du problème : recherche utilisateur, validation du marché et analyse de faisabilité technique, pour être sûrs de construire la bonne chose.",
        deliverables: ["Synthèse de la recherche utilisateur", "Rapport de validation lean", "Feuille de route technique"],
      },
      {
        title: "Concevoir & Construire",
        description:
          "Conception d'interface et d'interaction soutenue par une livraison d'ingénierie robuste. Nous prototypons vite et itérons à partir de retours réels.",
        deliverables: ["Prototypes interactifs", "Développement frontend & backend", "Infrastructure cloud"],
      },
      {
        title: "Lancer & Évoluer",
        description:
          "Itération continue, analyse des données et expériences de croissance axées sur le produit. Nous restons engagés après le lancement pour optimiser les résultats.",
        deliverables: ["Pipelines CI/CD", "Instrumentation analytique", "Optimisation de la croissance"],
      },
    ],
    outcomesBadge: "Les résultats d'abord",
    outcomesTitle: "Des solutions qui alignent marque, expérience et ingénierie",
    ctaTitle: "Un projet en tête ?",
    ctaBody: "Parlez-nous de votre défi et nous réunirons la bonne équipe.",
    ctaBook: "Réserver une session de travail",
    ctaWork: "Voir nos réalisations",
    crumbHome: "Accueil",
    crumbPage: "Services",
  },
}[lang];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: text.crumbHome, item: `${SITE_URL}${prefix}/` },
    { "@type": "ListItem", position: 2, name: text.crumbPage, item: `${SITE_URL}${prefix}/services/` },
  ],
};
---

<SiteShell
  lang={lang}
  title={text.title}
  description={text.description}
  canonical={`${prefix}/services/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

  <section class="pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-[1200px] px-6 lg:px-8">
      <SectionBadge>{text.badge}</SectionBadge>
      <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
        {text.heading}{" "}
        <span
          class="bg-gradient-to-r from-rose-400 via-red-400 to-orange-300 bg-clip-text text-transparent"
          >{text.headingAccent}</span
        >
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">{text.intro}</p>
    </div>
  </section>

  <section class="border-t border-white/5 bg-slate-950/70 py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {
          serviceList.map((service) => (
            <div id={service.slug} class="group relative overflow-hidden rounded-[32px] border border-white/10 bg-white/[0.04] p-8 transition-all hover:-translate-y-1 hover:border-rose-500/40 hover:bg-white/[0.06] lg:p-10">
              <div class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <div class="absolute inset-0 bg-gradient-to-br from-rose-500/20 via-red-400/15 to-orange-400/20 blur-3xl" />
              </div>
              <div class="relative space-y-6">
                <h2 class="text-2xl font-semibold text-white">{service.title}</h2>
                <p class="text-sm leading-relaxed text-slate-300">{service.description}</p>
                <div class="flex flex-wrap gap-2 pt-2">
                  {service.tags.map((tag) => (
                    <span class="rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-wide text-rose-200">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-[1200px] px-6 lg:px-8">
      <SectionBadge>{text.processBadge}</SectionBadge>
      <h2 class="mt-6 text-3xl font-bold text-white sm:text-4xl">{text.processTitle}</h2>
      <div class="mt-16 grid gap-8 lg:grid-cols-3">
        {
          text.steps.map((step, i) => (
            <div class="relative rounded-[32px] border border-white/10 bg-white/[0.04] p-8 lg:p-10">
              <span class="text-5xl font-bold text-rose-500/20">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-4 text-xl font-semibold text-white">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-300">{step.description}</p>
              <ul class="mt-6 space-y-2">
                {step.deliverables.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-slate-400">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-rose-400" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-slate-950/70 py-24">
    <div class="mx-auto max-w-[1200px] px-6 lg:px-8">
      <SectionBadge>{text.outcomesBadge}</SectionBadge>
      <h2 class="mt-6 text-3xl font-bold text-white sm:text-4xl">{text.outcomesTitle}</h2>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {
          capabilityList.map((cap) => (
            <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.06] to-transparent p-8 backdrop-blur lg:p-10">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-rose-200">
                {cap.title}
              </p>
              <h3 class="mt-4 text-lg font-semibold text-white">{cap.description}</h3>
              <ul class="mt-4 space-y-2 text-sm text-slate-300">
                {cap.points.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-rose-300" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-[1200px] px-6 text-center lg:px-8">
      <div
        class="rounded-[40px] border border-white/10 bg-gradient-to-r from-rose-600/35 via-red-500/25 to-orange-400/30 p-12 backdrop-blur lg:p-16"
      >
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{text.ctaTitle}</h2>
        <p class="mt-4 text-lg text-slate-200">{text.ctaBody}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="https://cal.com/codelovers/30min?user=codelovers&overlayCalendar=true&layout=month_view"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3 text-sm font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-rose-100"
          >
            {text.ctaBook} <span>↗</span>
          </a>
          <a
            href={`${prefix}/case-studies/`}
            class="inline-flex items-center gap-2 rounded-full border border-white/40 px-8 py-3 text-sm font-semibold text-white transition hover:border-white hover:text-rose-200"
          >
            {text.ctaWork} <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteShell>
