<style is:global>
  html[data-preview]{scroll-behavior:auto}
  body[data-preview]{--header-height:0px;background:#05060f;color:#ededed}
  body[data-preview] .site-shell{background:#05060f}
  body[data-preview] [data-article]{padding-top:2rem}
  body[data-preview] .site-shell a[class*="bg-gradient"]{background:#d32223;color:#fff}
  body[data-preview] .site-shell .bg-clip-text{background:none;color:#fda4af;-webkit-text-fill-color:#fda4af}
  body[data-preview] .site-shell .text-slate-400{color:#b9c0ce}
  body[data-preview] [aria-labelledby="cta-heading"]{background:#111521;border-color:#737b8b}
  body[data-preview] .site-shell :is(a,button,input,select,textarea,summary):focus-visible{outline:3px solid #fff;outline-offset:4px}
  body[data-preview] .site-shell .workflow :is(a,summary):focus-visible{outline-color:#05060f}
  body[data-preview] :is(summary,[id]){scroll-margin-top:1.5rem}
  body[data-preview] .blog-prose>details{padding:20px;border:1px solid #737b8b;border-radius:12px;color:#ededed}
  body[data-preview] .blog-prose summary{min-height:44px;padding:8px 0;font-weight:600;cursor:pointer;color:inherit}
  body[data-preview] .blog-prose>details[open]>summary{margin-bottom:24px}
</style>
