---
import type { CollectionEntry } from "astro:content";

interface Props {
  resources: CollectionEntry<"blog">["data"]["resources"];
  lang: "en" | "fr";
}

const { resources, lang } = Astro.props;
const french = lang === "fr";

const kinds = {
  "case-study": french ? "Cas client" : "Case study",
  guide: french ? "Guide" : "Guide",
  download: french ? "Modèle" : "Template",
  external: french ? "Externe" : "External",
} as const;

const hasExternal = resources.some((resource) => resource.kind === "external");
const t = french
  ? { heading: "Ressources", intro: "Pour aller plus loin.", external: "Les liens marqués", externalEnd: "mènent vers un autre site et s’ouvrent dans un nouvel onglet.", newTab: "nouvel onglet" }
  : { heading: "Resources", intro: "To go further.", external: "Links marked", externalEnd: "lead to another site and open in a new tab.", newTab: "new tab" };

const arrow = `<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>`;
const download = `<path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path>`;
const external = `<path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>`;
---

<section id="ressources" aria-labelledby="ressources-heading" class="mt-14">
  <h2 id="ressources-heading" class="text-[28px] font-semibold leading-tight tracking-tight text-white">{t.heading}</h2>
  <p class="mt-3 text-[15px] text-slate-400">
    {t.intro}
    {
      hasExternal && (
        <>
          {t.external}
          <svg class="inline align-[-2px] text-rose-400" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={external} />
          {t.externalEnd}
        </>
      )
    }
  </p>
  <div class="mt-5 grid gap-3 sm:grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
    {
      resources.map((resource) => (
        <a
          href={resource.href}
          target={resource.kind === "external" ? "_blank" : undefined}
          rel={resource.kind === "external" ? "noopener noreferrer" : undefined}
          download={resource.kind === "download" ? "" : undefined}
          aria-label={resource.kind === "external" ? `${resource.title} (${t.newTab})` : undefined}
          class="flex flex-col gap-2.5 rounded-[18px] border border-white/10 bg-white/[0.03] p-5 text-slate-100 transition hover:border-white/25"
        >
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-orange-300">{kinds[resource.kind]}</span>
            <svg class="text-rose-400" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={resource.kind === "download" ? download : resource.kind === "external" ? external : arrow} />
          </div>
          <span class="text-base font-semibold leading-snug text-white">{resource.title}</span>
          {resource.meta && <span class="font-mono text-xs text-slate-400">{resource.meta}</span>}
        </a>
      ))
    }
  </div>
</section>
