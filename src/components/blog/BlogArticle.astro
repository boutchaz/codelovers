---
import PostCover from "@/components/blog/PostCover.astro";
import ResourceCards from "@/components/blog/ResourceCards.astro";
import SeriesNav from "@/components/blog/SeriesNav.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { SITE_URL } from "@/data/constants";
import { getListedPosts, getPosts, getSeriesNav, readingTime, slugify } from "@/data/blog";

import type { MarkdownHeading } from "@astrojs/markdown-remark";
import type { Post } from "@/data/blog";
interface Props {
  post: Pick<Post, "id" | "body" | "data">;
  headings: MarkdownHeading[];
  preview?: boolean;
}

const { post, headings, preview = false } = Astro.props;
const { title, description, date, author, language, tags, product, cover, resources } = post.data;
const french = language === "fr";
const minutes = readingTime(post.body);

const t = french
  ? {
      blog: "Blog",
      crumbs: "Fil d’Ariane",
      series: "Série",
      read: "min de lecture",
      toc: "Dans cet article",
      guide: "Dans ce guide",
      topics: "Sujets",
      resources: "Ressources",
      related: "À lire aussi",
      all: "Tous les articles",
    }
  : {
      blog: "Blog",
      crumbs: "Breadcrumb",
      series: "Series",
      read: "min read",
      toc: "In this article",
      guide: "In this guide",
      topics: "Topics",
      resources: "Resources",
      related: "More from the studio",
      all: "All posts",
    };

const dateLabel = date.toLocaleDateString(french ? "fr-FR" : "en-US", { day: "numeric", month: "short", year: "numeric" });
const topic = tags[0];
const initials = author.match(/\p{Lu}/gu)?.join("").slice(0, 2) ?? author.slice(0, 2).toUpperCase();

// The table of contents lists the article's sections, then the resources block when there is one.
const toc = headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ slug, text }));
if (resources.length > 0) toc.push({ slug: "ressources", text: t.resources });

// The first tag is the post's topic and opens the blog index on it. A tag that names the post's product opens that
// product's case study. Any other tag is a plain label.
const tagLink = (tag: string, index: number) =>
  index === 0 ? `/blog/?topic=${slugify(tag)}` : product && slugify(tag) === product ? `/case-studies/${product}/` : null;

const seriesNav = getSeriesNav(post, await getPosts());

const related = (await getListedPosts())
  .filter((item) => item.id !== post.id)
  .sort(
    (a, b) =>
      Number(b.data.product === product) - Number(a.data.product === product) ||
      Number(b.data.language === language) - Number(a.data.language === language) ||
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .slice(0, 3);

const BOOKING_URL = "https://cal.com/codelovers/30min?user=codelovers&overlayCalendar=true&layout=month_view";
const productCtas = {
  "passion-fitness": {
    fr: {
      label: "Passion Fitness",
      title: "Voir Passion Fitness dans votre salle",
      body: "Réservations, présence et progression des ceintures dans une seule application, pour vos coachs et vos membres. Réservez 30 minutes pour une démo.",
      book: "Réserver une démo",
      more: "Lire le cas client",
    },
    en: {
      label: "Passion Fitness",
      title: "See Passion Fitness in your gym",
      body: "Bookings, attendance and belt progression in one app for your coaches and members. Book 30 minutes for a demo.",
      book: "Book a demo",
      more: "Read the case study",
    },
  },
} as const;
const productCta = product ? productCtas[product as keyof typeof productCtas]?.[language] : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  inLanguage: language,
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: {
    "@type": "Organization",
    name: author,
    url: `${SITE_URL}/`,
  },
  publisher: {
    "@type": "Organization",
    name: "CodeLovers",
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/logo.png`,
  },
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
};

const chip =
  "inline-flex min-h-8 items-center rounded-full border border-white/15 px-3 text-[13px] text-slate-300";
const sectionLabel = "font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-slate-400";
---

<SiteShell
  preview={preview}
  lang={language}
  title={title}
  description={description}
  canonical={preview ? undefined : `/blog/${post.id}/`}
  ogType="article"
  publishedTime={preview ? undefined : date.toISOString()}
>
  {!preview && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, "\\u003c")} slot="head" />}

  {post.data.erpRevision && <meta slot="head" name="codelovers-content-revision" content={post.data.erpRevision} />}

  <div class="pb-24 pt-28 sm:pt-32" data-article={post.id} data-product={product || undefined}>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <div class="mx-auto max-w-[1200px] px-6 lg:px-8">
      <header class="mx-auto max-w-[920px] pt-8">
        <nav aria-label={t.crumbs} class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
          <a href="/blog/" class="inline-flex min-h-11 items-center text-slate-300 transition hover:text-white">{t.blog}</a>
          {
            topic && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/blog/?topic=${slugify(topic)}`} class="inline-flex min-h-11 items-center text-slate-300 transition hover:text-white">{topic}</a>
              </>
            )
          }
        </nav>

        {
          seriesNav && (
            <a href="#serie" class="mt-4 inline-flex items-center gap-3 rounded-full border border-orange-300/35 bg-orange-300/[0.06] py-2 pl-2 pr-3.5 text-[13px] text-slate-100 transition hover:border-orange-300/60">
              <span class="rounded-full bg-orange-300 px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-slate-950">{t.series}</span>
              <span>
                {seriesNav.title} · <span class="whitespace-nowrap text-orange-300">{seriesNav.position} / {seriesNav.total}</span>
              </span>
            </a>
          )
        }

        <h1 class="mt-6 text-4xl font-bold leading-[1.05] tracking-[-0.035em] text-white sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-6 max-w-[720px] text-xl leading-relaxed text-slate-400">{description}</p>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-white/10 py-4">
          <div class="flex items-center gap-3">
            <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-rose-600 text-sm font-bold text-white">{initials}</span>
            <div class="flex flex-col gap-0.5">
              <span class="text-sm font-semibold text-white">{author}</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-slate-400">
                <time datetime={date.toISOString()}>{dateLabel}</time> · {minutes} {t.read} · {language.toUpperCase()}
              </span>
            </div>
          </div>
          {!preview && <ShareButtons slug={post.id} title={title} lang={language} />}
        </div>
      </header>

      {
        cover && (
          <div class="mx-auto mt-10 max-w-[1100px] overflow-hidden rounded-[28px] border border-white/10 bg-[#0b0d1a]">
            <div class="mx-auto max-w-[640px]">
              <PostCover kind={cover} />
            </div>
          </div>
        )
      }

      <div class="mx-auto mt-16 flex max-w-[1100px] flex-wrap gap-x-16 gap-y-12">
        <aside class="hidden min-w-0 max-w-[260px] flex-[1_1_220px] lg:block">
          <div class="flex flex-col gap-8 lg:sticky lg:top-28">
            {
              toc.length > 0 && (
                <nav aria-labelledby="toc-heading" class="flex flex-col gap-1">
                  <div class="mb-2 flex items-baseline justify-between gap-2">
                    <h2 id="toc-heading" class={sectionLabel}>{t.toc}</h2>
                    <span class="font-mono text-[11px] text-orange-300">{minutes} min</span>
                  </div>
                  {toc.map((item, i) => (
                    <a
                      href={`#${item.slug}`}
                      data-toc-link={item.slug}
                      aria-current={!preview && i === 0 ? "true" : undefined}
                      class="flex min-h-10 items-center border-l-2 border-white/10 pl-3.5 text-sm text-slate-400 transition hover:text-white aria-[current=true]:border-red-400 aria-[current=true]:font-medium aria-[current=true]:text-white"
                    >
                      {item.text}
                    </a>
                  ))}
                </nav>
              )
            }
            <div class="flex flex-col gap-2.5">
              <h2 class={sectionLabel}>{t.guide}</h2>
              <div class="flex flex-wrap gap-x-3.5 gap-y-1.5 text-[13px] text-slate-300">
                <span class="inline-flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fdba74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  {minutes} min
                </span>
                {
                  resources.length > 0 && (
                    <span class="inline-flex items-center gap-1.5">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fdba74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l3 3v15H6z"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></svg>
                      {resources.length} {french ? (resources.length > 1 ? "ressources" : "ressource") : resources.length > 1 ? "resources" : "resource"}
                    </span>
                  )
                }
              </div>
            </div>
            {
              tags.length > 0 && (
                <div class="flex flex-col gap-2.5">
                  <h2 class={sectionLabel}>{t.topics}</h2>
                  <div class="flex flex-wrap gap-2">
                    {tags.map((tag, i) => {
                      const href = tagLink(tag, i);
                      return href ? (
                        <a href={href} class={`${chip} transition hover:border-white/30 hover:text-white`}>{tag}</a>
                      ) : (
                        <span class={chip}>{tag}</span>
                      );
                    })}
                  </div>
                </div>
              )
            }
          </div>
        </aside>

        <div class="min-w-0 max-w-[700px] flex-[999_1_560px]">
          <div class="blog-prose text-lg text-slate-300">
            <slot />
          </div>

          {resources.length > 0 && <ResourceCards resources={resources} lang={language} />}

          {
            productCta ? (
              <section aria-labelledby="demo-heading" class="mt-14 flex flex-col gap-3 rounded-[28px] border border-red-400/35 bg-rose-600/10 p-8">
                <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-rose-400">{productCta.label}</span>
                <h2 id="demo-heading" class="text-[26px] font-bold leading-tight tracking-tight text-white">{productCta.title}</h2>
                <p class="text-base leading-relaxed text-slate-300">{productCta.body}</p>
                <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-3">
                  <a
                    href={BOOKING_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-[22px] text-[15px] font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-rose-100"
                  >
                    {productCta.book} <span aria-hidden="true">→</span>
                  </a>
                  <a href={`/case-studies/${product}/`} class="inline-flex min-h-11 items-center text-[15px] text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">{productCta.more}</a>
                </div>
              </section>
            ) : (
              <div class:list={["mt-14", {"grid gap-6 sm:grid-cols-2": product === "agrogina"}]}>
                {product === "agrogina" && <section aria-labelledby="explore-agrogina-heading" class="rounded-[28px] border border-[#737b8b] bg-[#111521] p-8 sm:p-10">
                  <h2 id="explore-agrogina-heading" class="text-2xl font-semibold text-white">{french ? "Découvrez AgroGina" : "Explore AgroGina"}</h2>
                  <p class="mt-3 text-slate-200">{french ? "Découvrez la plateforme qui connecte les opérations agricoles et les données du terrain." : "Discover the platform connecting farm operations with evidence from the field."}</p>
                  <a href="https://agrogina.com/" class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-rose-100">{french ? "Découvrir AgroGina" : "Explore AgroGina"} <span aria-hidden="true">→</span></a>
                </section>}
              <section aria-labelledby="cta-heading" class=" rounded-[28px] border border-white/10 bg-gradient-to-r from-rose-600/25 via-red-500/15 to-orange-400/20 p-8 sm:p-10">
                <h2 id="cta-heading" class="text-2xl font-semibold text-white">{french ? "Construisez avec CodeLovers" : "Build with CodeLovers"}</h2>
                <p class="mt-3 text-slate-200">
                  {french ? "Un projet en tête ? Réunissons stratégie, design et ingénierie pour le concrétiser." : "Have a product challenge? We will assemble strategy, design, and engineering around your outcomes."}
                </p>
                <a
                  href="/#contact"
                  class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-rose-100"
                >
                  {french ? "Parlons de votre projet" : "Start a project"} <span aria-hidden="true">→</span>
                </a>
              </section>
              </div>
            )
          }

          {
            tags.length > 0 && (
              <div class="mt-10 flex flex-wrap gap-2 lg:hidden" aria-label={t.topics}>
                {tags.map((tag, i) => {
                  const href = tagLink(tag, i);
                  return href ? <a href={href} class={chip}>{tag}</a> : <span class={chip}>{tag}</span>;
                })}
              </div>
            )
          }
        </div>
      </div>

      {seriesNav && <SeriesNav nav={seriesNav} lang={language} />}

      {
        related.length > 0 && (
          <section aria-labelledby="related-heading" class="mx-auto mt-[72px] max-w-[1100px]">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 id="related-heading" class="text-2xl font-semibold tracking-tight text-white">{t.related}</h2>
              <a href="/blog/" class="inline-flex min-h-11 items-center text-sm font-semibold text-rose-300 transition hover:text-rose-200">{t.all} →</a>
            </div>
            <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((item) => (
                <a href={`/blog/${item.id}/`} class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] transition hover:border-rose-500/30 hover:bg-white/[0.05]">
                  {item.data.cover && (
                    <div class="border-b border-white/5 bg-[#0b0d1a]">
                      <PostCover kind={item.data.cover} />
                    </div>
                  )}
                  <div class="flex flex-col gap-2.5 p-6">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-slate-400">
                      {item.data.date.toLocaleDateString(french ? "fr-FR" : "en-US", { day: "numeric", month: "short", year: "numeric" })}
                      {item.data.tags[0] && ` · ${item.data.tags[0]}`} · {item.data.language.toUpperCase()}
                    </span>
                    <h3 class="text-[19px] font-semibold leading-snug text-white" lang={item.data.language}>{item.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</SiteShell>

<script>
  // Highlights the table-of-contents entry of the section being read.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  if (links.length > 0) {
    const sections = links.map((link) => document.getElementById(link.dataset.tocLink!));
    let frame = 0;
    const update = () => {
      frame = 0;
      let active = 0;
      sections.forEach((section, i) => {
        if (section && section.getBoundingClientRect().top <= 160) active = i;
      });
      links.forEach((link, i) => {
        if (i === active) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };
    addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // "Copier le lien": copies the link, shows a tick for a moment and tells screen readers.
  document.querySelector<HTMLButtonElement>('[data-share="copy"]')?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    const url = button.dataset.copyUrl ?? location.href;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // The clipboard API needs a secure, focused page. Fall back to selecting a hidden field and copying it.
      const field = document.createElement("textarea");
      field.value = url;
      field.setAttribute("readonly", "");
      field.style.cssText = "position:fixed;top:0;left:0;opacity:0";
      document.body.append(field);
      field.select();
      const copied = document.execCommand("copy");
      field.remove();
      if (!copied) return;
    }
    button.dataset.copied = "true";
    if (status) status.textContent = status.dataset.copiedText ?? "";
    setTimeout(() => {
      delete button.dataset.copied;
      if (status) status.textContent = "";
    }, 1600);
  });
</script>

<style>
  /* CSS-only so private reviews retain their no-script security policy. */
  [data-article] { timeline-scope: --article-reading; }
  .blog-prose { view-timeline: --article-reading block; }
  .reading-progress { display:none; }
  @supports (animation-timeline: --article-reading) and (timeline-scope: --article-reading) {
    .reading-progress { display:block; position:fixed; inset:0 0 auto; height:4px; z-index:1000; background:#333b4c; pointer-events:none; }
    .reading-progress span { display:block; width:100%; height:100%; background:#f43f5e; transform-origin:left; --reading-timeline:--article-reading; animation:reading-progress 1s linear both; animation-timeline:var(--reading-timeline); animation-range:contain 0% contain 100%; }
  }
  @keyframes reading-progress { from { transform:scaleX(0); } to { transform:scaleX(1); } }
</style>
