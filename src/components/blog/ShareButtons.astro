---
import { SITE_URL } from "@/data/constants";

interface Props {
  slug: string;
  title: string;
  lang: "en" | "fr";
}

const { slug, title, lang } = Astro.props;
const french = lang === "fr";

// Each channel gets its own utm_source, so visits that come from a share are attributed to it in PostHog.
const link = (source: string) =>
  `${SITE_URL}/blog/${slug}/?${new URLSearchParams({ utm_source: source, utm_medium: "share", utm_campaign: slug })}`;

const t = french
  ? { share: "Partager", linkedin: "Partager sur LinkedIn", whatsapp: "Partager sur WhatsApp", copy: "Copier le lien", copied: "Lien copié" }
  : { share: "Share", linkedin: "Share on LinkedIn", whatsapp: "Share on WhatsApp", copy: "Copy link", copied: "Link copied" };

const button =
  "flex size-11 items-center justify-center rounded-full border border-white/15 text-slate-300 transition hover:border-white/30 hover:text-white";
---

<div class="flex items-center gap-2" data-share-bar>
  <span class="mr-1 text-[13px] text-slate-400">{t.share}</span>
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(link("linkedin"))}`}
    target="_blank"
    rel="noopener noreferrer"
    data-share="linkedin"
    aria-label={`${t.linkedin} (${french ? "nouvel onglet" : "new tab"})`}
    class={button}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7"></path><path d="M8 7v.01"></path><path d="M12 17v-4a2 2 0 0 1 4 0v4"></path><path d="M12 10v7"></path></svg>
  </a>
  <a
    href={`https://wa.me/?text=${encodeURIComponent(`${title} ${link("whatsapp")}`)}`}
    target="_blank"
    rel="noopener noreferrer"
    data-share="whatsapp"
    aria-label={`${t.whatsapp} (${french ? "nouvel onglet" : "new tab"})`}
    class={button}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"></path><path d="M9.5 9.5c.3 1.8 2.2 3.7 4 4l1-1 1.5.8-.5 1.4c-3 .2-6.5-3.2-6.3-6.3l1.4-.5.8 1.5z"></path></svg>
  </a>
  <button type="button" data-share="copy" data-copy-url={link("copy")} aria-label={t.copy} class={`${button} group bg-transparent`}>
    <svg class="group-data-[copied=true]:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
    <svg class="hidden group-data-[copied=true]:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fdba74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
  </button>
  <span role="status" aria-live="polite" class="sr-only" data-copy-status data-copied-text={t.copied}></span>
</div>
