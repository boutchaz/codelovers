# Enable only after ERP migration, permissions, owner and end-to-end validation.
PUBLIC_INQUIRY_ENABLED=false
ERP_URL=https://erp.boutchaz.dev
ERP_INTAKE_API_KEY=
ERP_INTAKE_API_SECRET=
# Cal.com booking webhook signing secret (Cal.com -> Settings -> Developer -> Webhooks). Server only.
CAL_WEBHOOK_SECRET=
# Optional; the existing analytics integration stays off without this public key.
PUBLIC_POSTHOG_KEY=

# Newsletter: enable only after sender, lists and DOI templates are verified.
PUBLIC_NEWSLETTER_ENABLED=false
NEWSLETTER_ENABLED=false
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_EN=
BREVO_NEWSLETTER_LIST_FR=
BREVO_DOI_TEMPLATE_EN=
BREVO_DOI_TEMPLATE_FR=
